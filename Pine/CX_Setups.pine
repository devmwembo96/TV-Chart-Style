poiLnCol  = input.color(#131722, "Ligne du POI", group = G7, inline = "pl")
poiLnW    = input.int(1, "épaisseur", minval = 1, maxval = 4, group = G7, inline = "pl")
showEt    = input.bool(true, "Type d'entrée sur l'étiquette (Direct / Confirmation)", group = G7)
reqLiq    = input.bool(false, "Seulement les POI avec de la liquidité devant", group = G7)
