lvSz   = input.string(size.tiny, "", options = [size.tiny, size.small, size.normal], group = G6, inline = "lt")
shTkI  = input.bool(false, "Afficher les niveaux balayés aujourd'hui (très clair, ✕ au balayage)", group = G6)
