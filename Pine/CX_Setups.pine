s1Bias   = input.bool(true, "Filtre biais TRADE", group = GS1, inline = "f")
s1TT     = input.bool(true, "temps de trading", group = GS1, inline = "f")
s1PD     = input.bool(true, "premium / discount", group = GS1, inline = "f")

GS2 = "S2 · Sweep de liquidité + CISD"
s2On     = input.bool(true, "Activer S2", group = GS2, tooltip = "Un niveau de liquidité actif est balayé (mèche au-delà, clôture revenue), puis CISD dans les bougies suivantes. Une clôture au-delà de 1.5 × la marge LuxAlgo annule (fausse cassure).")
s2Wait   = input.int(10, "Bougies pour le CISD", minval = 1, maxval = 50, group = GS2)
