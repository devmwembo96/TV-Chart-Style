minStk   = input.int(2, "Niveaux empilés pour Direct", minval = 2, maxval = 5, group = G7)
clMult   = input.float(0.3, "Empilés = niveaux à moins de (× ATR 1H)", minval = 0.05, step = 0.05, group = G7)
sprIn    = input.float(0, "Tolérance de spread (prix, 0 = auto)", minval = 0, step = 0.01, group = G7, tooltip = "0 = auto : 0.30 sur l'or, 1 pip sur le forex.")
maxAgeD  = input.int(4, "POI des derniers", minval = 1, maxval = 60, group = G7, inline = "age")
ageMode  = input.string("Trading days", "", options = ["Trading days", "Calendar days"], group = G7, inline = "age")
