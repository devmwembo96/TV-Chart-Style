swpFC  = input.color(color.new(#787B86, 73), "", group = GSW, inline = "f")

G7 = "POI et type d'entrée (ISLB)"
showPoi  = input.bool(true, "Afficher les POI du setup en cours", group = G7, tooltip = "OB et FVG des unités 1H, 4H et Daily, du côté du biais TRADE seulement. Le plus proche par unité.")
p1H      = input.bool(true, "1H", group = G7, inline = "tf")
p4H      = input.bool(true, "4H", group = G7, inline = "tf")
pDy      = input.bool(true, "Daily", group = G7, inline = "tf")
poiOB    = input.bool(true, "OB", group = G7, inline = "ty")
poiRB    = input.bool(true, "RB", group = G7, inline = "ty")
poiBB    = input.bool(true, "BB", group = G7, inline = "ty")
