uNp    = input.bool(true, "NY PM H / L (si la séance est active)", group = G6, inline = "p")
shNp   = input.bool(true, "afficher", group = G6, inline = "p")
uEq    = input.bool(true, "EQH / EQL (15m)", group = G6, inline = "e")
shEq   = input.bool(true, "afficher", group = G6, inline = "e")
eqTol  = input.float(0.1, "Égaux = à moins de (× ATR 15m)", minval = 0.01, step = 0.01, group = G6)
shP50  = input.bool(false, "Milieu de la veille (PD 50 %), affiché seulement", group = G6)
lvCol  = input.color(color.new(#787B86, 40), "Ligne des niveaux", group = G6, inline = "ls")
