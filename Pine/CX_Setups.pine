GS4 = "S4 · PO3 (C2 + CISD)"
s4On     = input.bool(true, "Activer S4", group = GS4, tooltip = "La bougie HTF en cours (C2) balaie le plus haut (ou le plus bas) de la précédente (C1), puis CISD en sens inverse pendant C2.")
s4Align  = input.string("Auto", "Alignement", options = ["Auto", "M1 → M15", "M5 → H1", "M15 → H4", "H1 → D1", "Personnalisé"], group = GS4)
