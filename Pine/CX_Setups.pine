//@version=6
indicator("CX Setups", shorttitle = "CX Setups", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// =====================================================================================
//  CX Setups · stratégie intraday XAUUSD (M1 – M15), tout en un.
//
//  Crédits et licences des parties reprises :
//   · « ICT Sessions Liquidity & Bias » (ISLB) v3.8 : séances, bougies de liquidité,
//     points de liquidité, biais, POI et moteur Direct / Confirmation, statut de séance.
//     Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/).
//   · « ICT HTF FVGs » © fadizeidan : FVG des unités supérieures.
//     Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/).
//   · « Session Sweeps » © LuxAlgo : zones de sweep buyside / sellside.
//     Creative Commons BY-NC-SA 4.0 (https://creativecommons.org/licenses/by-nc-sa/4.0/) :
//     usage personnel, non commercial ; ce fichier dérivé reste sous la même licence.
//   · S4 PO3 : réalisation originale d'après une description publique (aucun code
//     d'origine) ; idée « PO3 Model » de CantoLab.
//   · Premium / Discount, setups S1 – S4, tableaux et suivi des trades : ajouts originaux.
//
//  Contenu :
//   1. Séances ISLB (heure de New York l'été, IST l'hiver comme ISLB) + NY PM optionnel.
//   2. Points de liquidité ISLB + PMH / PML, NY PM, PD 50 %, niveaux balayés du jour,
//      zones de sweep LuxAlgo sur chaque niveau balayé.
//   3. Premium / Discount du dernier range de swing (pivots M15 par défaut), OTE.
//   4. Biais ISLB (Daily, 4H, 1H, TRADE) + tableau NOW / NEXT.
//   5. POI ISLB (OB, RB, BB, CRB, IFVG) et FVG HTF (fadi).
//   6. Setups, signaux à la clôture : S1 rejet FVG HTF · S2 sweep de liquidité + CISD
//      S3 A+ liquidité balayée dans un POI / FVG HTF · S4 PO3 (C2 + CISD).
//      Flèche, entrée, SL, TP (liquidité ou R fixe), résolution ✓ TP / ✕ SL.
//   7. Un tableau par setup (checklist) et le tableau BIAS.
//   8. Alertes : une alerte « Any alert() function call » couvre tout (un message par
//      bougie, à la clôture) ; alertcondition par setup en plus.
// =====================================================================================

// ─────────────────────────── Affichage ───────────────────────────
G0 = "Affichage"
preset    = input.string("Épuré", "Préréglage d'affichage", options = ["Épuré", "Complet", "Personnalisé"], group = G0, tooltip = "Épuré : niveaux, FVG HTF, POI, signaux et tableaux ; sans zones de sweep, teinte premium / discount, OTE, projections PO3, bougies HTF ni niveaux balayés.\nComplet : tout.\nPersonnalisé : les interrupteurs de chaque groupe.")
startDate = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Afficher à partir du", group = G0, tooltip = "Rien n'est dessiné avant cette date.")
maxTF     = input.int(60, "Unité maximale pour les séances, POI et setups (minutes)", minval = 1, maxval = 1440, group = G0, tooltip = "Au-dessus, seuls les niveaux et le biais sont affichés (comme ISLB).")

G1 = "Séances"
season    = input.string("Auto", "Saison", options = ["Auto", "Summer", "Winter", "Manual (NY)"], group = G1, tooltip = "Auto : hiver tant que Londres est à l'heure GMT (dernier dimanche d'octobre au dernier dimanche de mars), sinon été.\nÉté (heure NY) : Asie 17:00 – 00:15, Frankfurt 01:00, killzone 02:00, Londres 03:00 – 05:00, bougie NY 07:00, New York 08:00 – 12:00.\nHiver (heure NY) : Asie 18:00 – 01:00, Frankfurt 01:00, killzone 02:00, Londres 03:00 – 06:00, bougie NY 06:00, New York 07:00 – 10:00.\nManual (NY) : les heures du groupe suivant, en heure de New York.")
nyPmOn    = input.bool(false, "Séance NY PM (13:00 – 16:00 NY)", group = G1)
nyPmTrd   = input.bool(true, "NY PM compte comme temps de trading", group = G1)

GM = "Heures manuelles (New York) · Saison = Manual (NY)"
manAs  = input.session("1800-0100", "Asie (or)", group = GM)
manFft = input.session("0100-0200", "Bougie de liquidité Frankfurt", group = GM)
manKz  = input.session("0200-0300", "Killzone de Londres", group = GM)
manLdS = input.session("0300-0600", "Séance de Londres", group = GM)
manLdT = input.session("0200-0600", "Temps de trading Londres", group = GM)
manNyL = input.session("0600-0700", "Bougie de liquidité NY", group = GM)
manNyT = input.session("0700-1000", "Temps de trading New York", group = GM)
manNyP = input.session("1300-1600", "NY PM", group = GM)

G2 = "Range d'Asie"
showBox = input.bool(true, "Afficher le range d'Asie", group = G2)
boxCol  = input.color(color.new(#B2B5BE, 75), "Couleur (transparence dans le sélecteur)", group = G2)

G3 = "Bougies de liquidité ($$$)"
showLiq = input.bool(true, "Marquer $$$ sur le haut et le bas des bougies de liquidité", group = G3)
liqCol  = input.color(#787B86, "Couleur des $$$", group = G3)
liqLine = input.bool(false, "Ligne à travers les $$$", group = G3)
hideSw  = input.bool(true, "Masquer le $$$ une fois balayé", group = G3)
liqGap  = input.float(0.15, "Écart bougie – $$$ (× ATR 14)", minval = 0, step = 0.05, group = G3)
txtSz   = input.string(size.tiny, "Taille du texte", options = [size.tiny, size.small, size.normal], group = G3)

G4 = "Biais"
showBias = input.bool(true, "Tableau BIAS", group = G4)
biasPos  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right", "Middle left"], group = G4)
lineSw   = input.bool(true, "Swings lus sur les clôtures (graphique en ligne)", group = G4, tooltip = "Oui : swings des clôtures. Non : swings des corps.")
swLen    = input.int(1, "Taille de swing 1H (bougies de chaque côté)", minval = 1, maxval = 10, group = G4)
showSt   = input.bool(true, "Statut de séance (NOW / NEXT)", group = G4)
boxSz    = input.string(size.small, "Taille du texte du tableau", options = [size.tiny, size.small, size.normal], group = G4)

// couleurs du ticket (tableaux) et de TradingView
color TK_BG   = #131722
color TK_BD   = #363A45
color TK_LB   = #868B98
color TK_TX   = color.white
color TV_GRN  = #089981
color TV_RED  = #F23645
color TV_ORG  = #FF9800
color TV_GRY  = #787B86
color biasCol = TK_LB
color buyCol  = TV_GRN
color sellCol = TV_RED

G6 = "Points de liquidité (utiliser = compter · afficher = dessiner)"
uAsia  = input.bool(true, "Asie H / L", group = G6, inline = "a")
shAsia = input.bool(true, "afficher", group = G6, inline = "a")
uFft   = input.bool(true, "Frankfurt H / L", group = G6, inline = "f")
shFft  = input.bool(true, "afficher", group = G6, inline = "f")
uNyc   = input.bool(true, "Bougie NY H / L", group = G6, inline = "n")
shNyc  = input.bool(true, "afficher", group = G6, inline = "n")
uKz    = input.bool(true, "Killzone H / L", group = G6, inline = "k")
shKz   = input.bool(true, "afficher", group = G6, inline = "k")
uLdn   = input.bool(true, "Londres H / L", group = G6, inline = "l")
shLdn  = input.bool(true, "afficher", group = G6, inline = "l")
uPd    = input.bool(true, "PDH / PDL", group = G6, inline = "d")
shPd   = input.bool(true, "afficher", group = G6, inline = "d")
uPw    = input.bool(true, "PWH / PWL", group = G6, inline = "w")
