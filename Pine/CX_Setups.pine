GS1 = "S1 · Rejet sur FVG HTF"
s1On     = input.bool(true, "Activer S1", group = GS1, tooltip = "FVG HTF actif (unités cochées dans FVG HTF), contact, pas de clôture au-delà du bord éloigné, puis rejet. Entrée à la clôture du rejet, SL derrière le bord éloigné du FVG.")
s1First  = input.bool(true, "Premier contact seulement", group = GS1)
