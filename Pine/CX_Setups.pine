oteI     = input.bool(false, "OTE 62 – 79 % (préréglage Personnalisé)", group = GPD)
oteCol   = input.color(color.new(#787B86, 85), "Couleur OTE", group = GPD)

G9 = "FVG HTF (fadi)"
f1On  = input.bool(false, "15m", group = G9, inline = "f1")
